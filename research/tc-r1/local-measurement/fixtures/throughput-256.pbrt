# Original non-primary measurement fixture; SPDX-License-Identifier: MIT OR Apache-2.0
# Authored for throughput, memory and dispatch-latency measurement only; not a
# corpus scene, never used for policy comparison. Admitted feature envelope only.
LookAt 0 0.6 -6 0 0 1 0 1 0
Camera "perspective" "float fov" [42] "float lensradius" [0]
Film "rgb" "integer xresolution" [256] "integer yresolution" [256]
Sampler "independent" "integer pixelsamples" [16]
Integrator "path" "integer maxdepth" [8] "bool regularize" [false]
PixelFilter "box" "float xradius" [0.5] "float yradius" [0.5]
WorldBegin
LightSource "infinite" "rgb L" [0.3 0.35 0.45]
LightSource "point" "point3 from" [2.5 4 -3] "rgb I" [25 22 18]
AttributeBegin
AreaLightSource "diffuse" "rgb L" [6 5 4] "bool twosided" [true]
Material "diffuse" "rgb reflectance" [0 0 0]
Shape "trianglemesh" "point3 P" [-1 3.5 0  1 3.5 0  1 3.5 2  -1 3.5 2] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Material "diffuse" "rgb reflectance" [0.5 0.5 0.45]
Shape "trianglemesh" "point3 P" [-6 -1 -5  -6 -1 7  6 -1 7  6 -1 -5] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Material "dielectric" "float eta" [1.5] "float roughness" [0]
Translate -1.3 0 1
Shape "sphere" "float radius" [0.9]
AttributeEnd
AttributeBegin
Material "conductor" "rgb reflectance" [0.85 0.75 0.6] "float roughness" [0.05]
Translate 1.2 -0.2 1.6
Shape "sphere" "float radius" [0.8]
AttributeEnd
AttributeBegin
Material "diffuse" "rgb reflectance" [0.2 0.45 0.7]
Translate 0.1 -0.55 -0.6
Shape "sphere" "float radius" [0.45]
AttributeEnd
